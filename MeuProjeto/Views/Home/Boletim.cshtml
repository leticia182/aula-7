@{
    ViewData["Title"] = "Boletim de Nota";
    var disciplinas = ViewBag.Disciplinas as List<string>;
    var notas = ViewBag.Notas as List<double>;
        double soma = 0;
}
<h2>Boletim de Nota</h2>
<table border="1" cellpadding="10">
    <tr>
        <th>Disciplina</th>
        <th>Nota</th>
        <th>Status</th>
        <th>Conceito</th>
    </tr>

    @for (int i = 0; i < disciplinas.Count; i++)
    {
        soma += notas[i];
        string conceito = "";
        switch ((int)notas[i])
        {
            case 10:
            case 9:
                conceito = "A";
                break;

                case 8:
                case 7:
                conceito = "B";
                break;

                case 6:
                case 5:
                conceito = "C";
                break;

                default:
                conceito = "D";
                break;

        }
        <tr>
            <td>@disciplinas[i]</td>
            <td>@notas[i]</td>
            @if (notas[i] >= 6)
            {
                <td style="color: green;">Aprovado</td>
            }
            else
            {
                <td style="color: red;">Reprovado</td>
            }
            <td>@conceito</td>
        </tr>
    }
    @{
        double media = soma / notas.Count;
    }
    <tr>
        <td colspan="4">
        <strong>Media Geral:
            @media.ToString("F2")
        </strong>
        </td>
    </tr>
</table>

           