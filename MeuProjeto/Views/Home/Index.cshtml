@{
    ViewData["Title"] = "Catalogo";

    var produtos = ViewBag.Preodutos as List<string>;
    var precos = ViewBag.Precos as List<double>;

}
<h2>Catalogo de Produtos</h2>
<table border="1">
    <tr>
        <th>#</th>
        <th>Produto</th>
        <th>Preço</th>
    </tr>
    @for (int i = 0; i < produtos.Count; i++)
    {
        if (precos[i] >= 0)
        {
            <tr style="background-color: lightgray;">
        
                <td>@(i + 1)</td>
                <td>@produtos[i]</td>
                <td>@precos[i].ToString("C")</td>
            </tr>
        }
        else
        {
            <tr>
                <td>@(i + 1)</td>
                <td>@produtos[i]</td>
                <td>Preço [i]</td>
            </tr>
            
        }
    }
</table>
<h3>Total: @produtos.Count produtos</h3>
